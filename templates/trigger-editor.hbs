<div class="dst-editor">
  <p class="dst-editor-trigger-text">{{#if triggerText}}<span class="dst-tt-pills">{{#each triggerPills}}{{#if isPill}}<button type="button" class="dst-tt-pill dst-tt-{{kind}} {{colour}}" data-index="{{clause}}" data-indexes="{{indexes}}" data-field="{{field}}" data-tooltip="{{tooltip}}"{{#if style}} style="{{style}}"{{/if}}>{{text}}</button>{{else}}<span class="dst-tt-plain">{{text}}</span>{{/if}}{{/each}}</span>{{else}}<em>{{noTriggerText}}</em>{{/if}}</p>
  <p class="dst-editor-status">{{statusLine}}</p>

  {{#if gain}}
  <fieldset class="dst-editor-gain">
    <legend>{{gain.legend}}</legend>
    <p class="dst-hint dst-gain-sentence"><em>{{gain.sentence}}</em></p>
    <div class="form-group">
      <label>{{gain.labels.name}}</label>
      <div class="form-fields"><input type="text" data-gain-field="name" value="{{gain.name}}" placeholder="{{gain.namePlaceholder}}"></div>
    </div>
    {{#if gain.manualWhy}}<p class="dst-hint dst-gain-manual">{{gain.manualWhy}}</p>{{/if}}
    <div class="form-group">
      <label>{{gain.labels.enabled}}</label>
      <div class="form-fields"><input type="checkbox" data-gain-field="enabled" {{#if gain.enabled}}checked{{/if}}></div>
    </div>
    <div class="form-group">
      <label>{{gain.labels.amount}}</label>
      <div class="form-fields"><input type="text" data-gain-field="amount" value="{{gain.amount}}"></div>
    </div>
    {{#if gain.upgradedBy}}<p class="dst-hint">{{gain.upgradedBy}}</p>{{/if}}
    <div class="form-group">
      <label>{{gain.labels.once}}</label>
      <div class="form-fields">
        <select data-gain-field="once">
          {{#each gain.onceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
    </div>
    {{#if gain.checks}}<p class="dst-hint">{{gain.checks}}</p>{{/if}}
  </fieldset>
  {{/if}}

  <div class="dst-editor-clauses">
    {{#each clauses}}
    <fieldset class="dst-editor-clause" data-index="{{index}}">
      <legend>{{legend}}
        <button type="button" class="dst-editor-clause-remove" data-action="removeClause" data-index="{{index}}" data-tooltip="{{@root.removeTooltip}}"><i class="fa-solid fa-trash"></i></button>
      </legend>
      <div class="form-group">
        <label>{{@root.labels.event}}</label>
        <div class="form-fields">
          <select data-field="event" data-index="{{index}}">
            {{#each eventGroups}}
            <optgroup label="{{label}}">
              {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </optgroup>
            {{/each}}
          </select>
        </div>
      </div>
      <p class="dst-hint dst-event-desc">{{eventHint}}</p>
      <div class="form-group">
        <label>{{@root.labels.scope}}</label>
        <div class="form-fields">
          <select data-field="scope" data-index="{{index}}">
            {{#each scopeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
      </div>
      <p class="dst-hint">{{@root.hints.scope}}</p>
      <div class="form-group">
        <label>{{@root.labels.range}}</label>
        <div class="form-fields">
          <select data-field="rangeSelect" data-index="{{index}}">
            {{#each rangeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
          <input type="number" min="1" step="1" data-field="rangeValue" data-index="{{index}}" value="{{rangeValue}}" {{#unless rangeCustom}}hidden{{/unless}}>
        </div>
      </div>
      <p class="dst-hint">{{@root.hints.range}}</p>
      <div class="form-group">
        <label>{{@root.labels.qualifiers}}</label>
        <div class="form-fields dst-qual-pills">
          {{#each qualifiers}}
          <button type="button" class="dst-qual-pill{{#if disabled}} dst-qual-off{{/if}}{{#if enforced}} dst-qual-live{{/if}}{{#if fromEffect}} dst-qual-effect{{/if}}{{#unless enforced}} dst-qual-plain{{/unless}}"
                  data-qual-toggle="{{id}}" data-index="{{../index}}" data-tooltip="{{tooltip}}">{{text}}</button>
          {{else}}
          <span class="dst-qual-empty">{{@root.labels.qualifiersNone}}</span>
          {{/each}}
        </div>
      </div>
      <p class="dst-hint">{{@root.hints.qualifiers}}</p>

      <div class="dst-exclself-wrap" {{#unless showTargetedHalf}}hidden{{/unless}}>
        <label class="checkbox"><input type="checkbox" data-field="excludeSelfTarget" data-index="{{index}}" {{#if excludeSelfTarget}}checked{{/if}}> {{@root.labels.excludeSelfTarget}}</label>
        <p class="dst-hint">{{@root.hints.excludeSelfTarget}}</p>
      </div>
      <div class="dst-postroll-wrap" {{#unless showPostRoll}}hidden{{/unless}}>
        <label class="checkbox"><input type="checkbox" data-field="postRoll" data-index="{{index}}" {{#if postRoll}}checked{{/if}}> {{@root.labels.postRoll}}</label>
        <p class="dst-hint">{{@root.hints.postRoll}}</p>
      </div>

      <div class="dst-damage-wrap" {{#unless showDamageTypes}}hidden{{/unless}}>
        <div class="form-group">
          <label>{{@root.labels.damageTypes}}</label>
          <div class="form-fields">
            <multi-select data-field="damageTypes" data-index="{{index}}">
              {{#each damageTypeOptions}}<option value="{{value}}" {{#if active}}selected{{/if}}>{{label}}</option>{{/each}}
            </multi-select>
          </div>
        </div>
        <p class="dst-hint">{{@root.hints.damageTypes}}</p>
      </div>

      <div class="dst-group-wrap" {{#unless showGroup}}hidden{{/unless}}>
        <div class="form-group">
          <label>{{@root.labels.groupName}}</label>
          <div class="form-fields">
            <select data-field="groupSelect" data-index="{{index}}">
              <option value="">{{@root.labels.groupNone}}</option>
              {{#each groupOptions}}<option value="{{value}}" {{#if active}}selected{{/if}}>{{label}}</option>{{/each}}
              {{#each customOptions}}<option value="{{value}}" {{#if active}}selected{{/if}}>{{value}}*</option>{{/each}}
              <option value="__custom__">{{@root.labels.customEllipsis}}</option>
            </select>
            {{#if customPending}}<input type="text" class="dst-custom-input" data-index="{{index}}" placeholder="{{@root.labels.customPh}}">{{/if}}
          </div>
        </div>
        <p class="dst-hint">{{@root.hints.groupName}}</p>
      </div>

      <div class="form-group">
        <label>{{@root.labels.abilityDsid}}</label>
        <div class="form-fields">
          <input type="text" data-field="abilityDsid" data-index="{{index}}" value="{{abilityDsid}}">
        </div>
      </div>
      <p class="dst-hint">{{@root.hints.abilityDsid}}</p>
      <label class="dst-section-label">{{@root.labels.availability}}</label>
      <div class="dst-editor-checks">
        <label class="checkbox"><input type="checkbox" data-field="edgeRequired" data-index="{{index}}" {{#if edgeRequired}}checked{{/if}}> {{@root.labels.edgeRequired}}</label>
        <label class="checkbox"><input type="checkbox" data-field="ownerUnacted" data-index="{{index}}" {{#if ownerUnacted}}checked{{/if}}> {{@root.labels.ownerUnacted}}</label>
        <label class="checkbox"><input type="checkbox" data-field="anyHeroUnacted" data-index="{{index}}" {{#if anyHeroUnacted}}checked{{/if}}> {{@root.labels.anyHeroUnacted}}</label>
        {{#if turnEvent}}
        <label class="checkbox"><input type="checkbox" data-field="turnLock" data-index="{{index}}" {{#if turnLock}}checked{{/if}}> {{@root.labels.turnLock}}</label>
        {{/if}}
      </div>
      <p class="dst-hint">{{@root.hints.checks}}</p>

      <h3 class="dst-settings-header dst-effects-header" {{#unless showEffects}}hidden{{/unless}}>{{@root.labels.effectsHeader}}</h3>
      <div class="dst-hold-wrap" {{#unless showHold}}hidden{{/unless}}>
        <label class="checkbox"><input type="checkbox" data-hold-toggle data-index="{{index}}" {{#if holdChecked}}checked{{/if}}> {{@root.labels.holdDamage}}</label>
        <p class="dst-hint">{{@root.hints.holdDamage}}</p>
      </div>
      <div class="dst-half-wrap" {{#unless showTargetedHalf}}hidden{{/unless}}>
        <label class="checkbox"><input type="checkbox" data-field="targetedHalf" data-index="{{index}}" {{#if targetedHalf}}checked{{/if}}> {{@root.labels.targetedHalf}}</label>
        <p class="dst-hint">{{@root.hints.targetedHalf}}</p>
      </div>
      <div class="dst-postroll-sub" {{#unless showHalfOnUse}}hidden{{/unless}}>
        <label class="checkbox"><input type="checkbox" data-field="halfOnUse" data-index="{{index}}" {{#if halfOnUse}}checked{{/if}}> {{@root.labels.halfOnUse}}</label>
        <p class="dst-hint">{{@root.hints.halfOnUse}}</p>
      </div>
      <div class="dst-redirect-wrap" {{#unless showPostRoll}}hidden{{/unless}}>
        <div class="form-group">
          <label>{{@root.labels.redirect}}</label>
          <div class="form-fields">
            <select data-field="redirectSelect" data-index="{{index}}">
              {{#each redirectOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </div>
        </div>
        <p class="dst-hint">{{@root.hints.redirect}}</p>
      </div>
      <div class="dst-rollmod-wrap" {{#unless showRollMod}}hidden{{/unless}}>
        <div class="form-group">
          <label>{{@root.labels.rollMod}}</label>
          <div class="form-fields">
            <select data-field="rollModSelect" data-index="{{index}}">
              {{#each rollModOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </div>
        </div>
        <p class="dst-hint">{{@root.hints.rollMod}}</p>
      </div>
    </fieldset>
    {{/each}}
  </div>

  <button type="button" class="dst-editor-add" data-action="addClause"><i class="fa-solid fa-plus"></i> {{labels.addClause}}</button>

  {{#unless gain}}
  <div class="form-group dst-editor-malice">
    <label>{{labels.malice}}</label>
    <div class="form-fields">
      <select data-field="malice">
        {{#each maliceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
  </div>
  <p class="dst-hint">{{hints.malice}}</p>
  {{/unless}}

  <footer class="dst-editor-footer">
    <button type="button" data-action="saveOverride" data-tooltip="{{hints.save}}"><i class="fa-solid fa-floppy-disk"></i> {{labels.save}}</button>
    <button type="button" data-action="resetParser" data-tooltip="{{hints.reset}}" {{#unless isManual}}disabled{{/unless}}><i class="fa-solid fa-rotate-left"></i> {{labels.reset}}</button>
  </footer>
</div>
