<div class="dst-shell{{#if rosterOpen}} roster-open{{/if}}">
<div class="dst-stack">
  {{#if entries.length}}
  <ul class="dst-stack-list">
    {{#each entries}}
    <li class="dst-stack-entry dst-stack-entry--{{state}}{{#if isHeld}} dst-stack-entry--held{{/if}}{{#if isDamageHeld}} dst-stack-entry--held dst-stack-entry--damage{{/if}}{{#if isResolutionHeld}} dst-stack-entry--held dst-stack-entry--resolution{{/if}}{{#if isReaper}} dst-stack-entry--reaper{{/if}}">
      {{#if isReaper}}
      <div class="dst-stack-eyebrow">
        <i class="fa-solid fa-skull dst-stack-held-icon"></i>
        <span class="dst-reaper-quote" data-tooltip-html="{{@root.labels.reaperMemorial}}">
          <span class="dst-stack-cause-text">{{@root.labels.reaperReason}}</span>
          <span class="dst-reaper-attribution">{{{@root.labels.reaperQuoteBy}}}</span>
        </span>
        <span class="dst-stack-age" data-created-at="{{createdAt}}"></span>
      </div>
      <div class="dst-stack-title-row">
        <span class="dst-stack-name">{{itemName}}</span>
        {{#if reaperStatus}}<span class="dst-reaper-status"><i class="fa-solid fa-hand-pointer"></i> {{reaperStatus}}</span>{{/if}}
      </div>
      <div class="dst-reaper-list">
        {{#if reaperGroups}}
        {{#each reaperGroups}}<span class="dst-reaper-group{{#if faded}} is-faded{{/if}}">{{{facesHTML}}}<span class="dst-reaper-label">{{label}}</span></span>{{/each}}
        {{else}}
        {{#each reaperCertain}}<span class="dst-reaper-token" data-tooltip="{{name}}"><img src="{{img}}" alt=""><span>{{name}}</span></span>{{/each}}
        {{#each reaperMaybe}}<span class="dst-reaper-token dst-reaper-token--maybe" data-tooltip="{{name}} &middot; {{@root.labels.reaperMaybe}}"><img src="{{img}}" alt=""><span>{{name}}</span></span>{{/each}}
        {{/if}}
      </div>
      {{else}}
      <div class="dst-stack-eyebrow">
        {{#if isResolutionHeld}}
        <i class="fa-solid fa-dice-d10 dst-stack-held-icon"></i>
        <span>{{heldEyebrow}}{{#if heldStatus}} &middot; {{heldStatus}}{{/if}}</span>
        {{#if isGrace}}
          <span class="dst-stack-eyebrow-status" data-grace-until="{{graceUntil}}"></span>
        {{else}}
          <span class="dst-stack-age" data-created-at="{{createdAt}}"></span>
        {{/if}}
        {{else if isDamageHeld}}
        <i class="fa-solid fa-hourglass-half dst-stack-held-icon"></i>
        <span>{{heldEyebrow}}{{#if heldStatus}} &middot; {{heldStatus}}{{/if}}</span>
        {{#if isGrace}}
          <span class="dst-stack-eyebrow-status" data-grace-until="{{graceUntil}}" data-grace-key="DS_TRIGGERS.Queue.GraceDamageCountdown"></span>
        {{else}}
          <span class="dst-stack-age" data-created-at="{{createdAt}}"></span>
        {{/if}}
        {{else if isHeld}}
        <i class="fa-solid fa-hourglass-half dst-stack-held-icon"></i>
        <span>{{heldEyebrow}}{{#if heldStatus}} &middot; {{heldStatus}}{{/if}}</span>
        {{#if isGrace}}
          <span class="dst-stack-eyebrow-status" data-grace-until="{{graceUntil}}"></span>
        {{else}}
          <span class="dst-stack-age" data-created-at="{{createdAt}}"></span>
        {{/if}}
        {{else}}
        <i class="fa-solid fa-turn-up dst-stack-eyebrow-icon"></i>
        {{#if choiceCauseHTML}}
        <span class="dst-stack-cause-text">{{{choiceCauseHTML}}}</span>
        {{else}}
        <span class="dst-stack-cause-text">{{causeLabel}}</span>
        {{/if}}
        {{#if isPending}}
        {{#if decideUntil}}
        <span class="dst-stack-eyebrow-status" data-grace-until="{{decideUntil}}" data-grace-key="DS_TRIGGERS.Queue.DecideCountdown"></span>
        {{else}}
        <span class="dst-stack-age" data-created-at="{{createdAt}}"></span>
        {{/if}}
        {{else}}
        <span class="dst-stack-eyebrow-status">{{stateLabel}}</span>
        {{/if}}
        {{/if}}
      </div>
      <div class="dst-stack-title-row">
        {{#if embedHTML}}
        <a class="dst-stack-embed-toggle" data-entry-id="{{id}}">
          <i class="fa-solid fa-chevron-{{#if embedOpen}}down{{else}}right{{/if}}"></i>
          {{#if iconSrc}}<img class="dst-stack-icon" src="{{iconSrc}}" alt="">{{/if}}
          <span class="dst-stack-name">{{itemName}}</span>
        </a>
        {{else}}
        {{#if isDamageHeld}}<span class="dst-stack-damage-icon"><i class="fa-solid fa-heart-crack"></i></span>{{/if}}
        {{#if iconSrc}}<img class="dst-stack-icon" src="{{iconSrc}}" alt="">{{/if}}
        <span class="dst-stack-name{{#if isDamageHeld}} dst-stack-name--damage{{/if}}">{{#if itemNameHTML}}{{{itemNameHTML}}}{{else}}{{itemName}}{{/if}}</span>
        {{#if isArea}}<span class="dst-chip dst-chip--area" data-tooltip="{{@root.labels.areaTooltip}}">{{@root.labels.area}}</span>{{/if}}
        {{/if}}
        {{{ownerFaces}}}
        {{#if ownerClickable}}
        <a class="dst-stack-owner dst-stack-owner-link" data-action="openOwner" data-uuid="{{ownerActorUuid}}">{{ownerName}}</a>
        {{else}}
        <span class="dst-stack-owner">{{ownerName}}</span>
        {{/if}}
        {{#if isFree}}<span class="dst-chip dst-chip--free">{{@root.labels.free}}</span>{{/if}}
        {{#if costBadge}}
        <span class="dst-stack-cost{{#if costBadge.malice}} dst-stack-cost--malice{{/if}}">
          {{#if costBadge.malice}}<img class="dst-malice-chip" src="{{@root.maliceChipURI}}" alt="">{{else}}<i class="fa-solid fa-bolt"></i>{{/if}} {{costBadge.label}}
        </span>
        {{/if}}
      </div>
      {{#if heldDetail}}
      <div class="dst-stack-held-detail">{{heldDetail}}</div>
      {{/if}}
      {{#if fmTrail.length}}
      <div class="dst-stack-fm-trail">
        {{#each fmTrail}}
        <span class="dst-fm-pill dst-fm-pill--{{dir}}" data-tooltip="{{tooltip}}">{{label}}</span>
        {{/each}}
        <span class="dst-fm-now{{#if fmStopped}} dst-fm-now--stopped{{/if}}">{{fmRunningLabel}}</span>
      </div>
      {{/if}}
      {{#if embedHTML}}
      <div class="dst-stack-embed-content" data-embed-for="{{id}}" {{#unless embedOpen}}hidden{{/unless}}>{{{embedHTML}}}</div>
      {{/if}}
      {{#if showButtons}}
      <div class="dst-stack-buttons{{#if notYours}} dst-stack-buttons--not-yours{{/if}}">
        {{#if isChoosing}}
        <button type="button" class="dst-stack-use dst-stack-choose{{#if gated}} dst-use-gated{{/if}}" data-action="chooseSubject" data-id="{{id}}"{{#if notYours}} disabled data-tooltip="{{notYoursTooltip}}"{{else if gated}} data-tooltip="{{@root.labels.gatedTooltip}}"{{else}} data-tooltip="{{@root.labels.chooseTooltip}}"{{/if}}><i class="fa-solid {{#if gated}}fa-lock{{else}}fa-crosshairs{{/if}}"></i> {{@root.labels.choose}}</button>
        {{else}}
        <button type="button" class="dst-stack-use{{#if gated}} dst-use-gated{{/if}}" data-action="useEntry" data-id="{{id}}"{{#if notYours}} disabled data-tooltip="{{notYoursTooltip}}"{{else if gated}} data-tooltip="{{@root.labels.gatedTooltip}}"{{/if}}><i class="fa-solid {{#if gated}}fa-lock{{else}}fa-bolt{{/if}}"></i> {{@root.labels.use}}</button>
        {{/if}}
        <button type="button" data-action="declineEntry" data-id="{{id}}"{{#if notYours}} disabled data-tooltip="{{notYoursTooltip}}"{{/if}}>{{@root.labels.decline}}</button>
        {{#if showMarkUsed}}<button type="button" data-action="markVillainUsed" data-id="{{id}}" data-tooltip="{{@root.labels.markUsedTooltip}}"><i class="fa-solid fa-check"></i> {{@root.labels.markUsed}}</button>{{/if}}
        {{#if @root.isGM}}<button type="button" class="dst-stack-dismiss" data-action="dismissEntry" data-id="{{id}}" data-tooltip="{{@root.labels.dismissTooltip}}"><i class="fa-solid fa-eye-slash"></i></button>{{/if}}
      </div>
      {{/if}}
      {{#if showRelease}}
      <div class="dst-stack-buttons">
        <button type="button" data-action="releaseHeld" data-resume-id="{{resumeId}}" data-tooltip="{{@root.labels.releaseTooltip}}"><i class="fa-solid fa-play"></i> {{@root.labels.release}}</button>
      </div>
      {{/if}}
      {{#if showApplyNow}}
      <div class="dst-stack-buttons">
        <button type="button" data-action="applyHeldNow" data-damage-ids="{{damageIdsJoined}}" data-tooltip="{{@root.labels.applyNowTooltip}}"><i class="fa-solid fa-heart-crack"></i> {{@root.labels.applyNow}}</button>
      </div>
      {{/if}}
      {{#if showReleaseResolution}}
      <div class="dst-stack-buttons">
        <button type="button" data-action="releaseResolutionNow" data-resolution-id="{{resolutionId}}" data-tooltip="{{@root.labels.releaseResolutionTooltip}}"><i class="fa-solid fa-play"></i> {{@root.labels.releaseResolution}}</button>
      </div>
      {{/if}}
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="dst-stack-empty">{{labels.empty}}</p>
  {{/if}}
</div>

<aside class="dst-roster{{#if rosterOpen}} expanded{{/if}}">
  <div class="dst-roster-head">
    <span class="dst-roster-title">{{labels.rosterTitle}}</span>
    {{#if roster.any}}
    <button type="button" class="dst-roster-all" data-action="snoozeAll" data-tooltip="{{labels.snoozeAllTooltip}}">
      <i class="fa-solid fa-bell-slash"></i>
    </button>
    {{/if}}
  </div>

  <div class="dst-roster-scroll">
  {{#unless roster.any}}
  <p class="dst-roster-empty">{{#if roster.isGM}}{{labels.rosterEmptyGM}}{{else}}{{labels.rosterEmptyPlayer}}{{/if}}</p>
  {{/unless}}

  {{#each roster.sections}}
  <details class="dst-roster-section dst-roster-section--{{id}}{{#if divided}} is-divided{{/if}}"{{#unless collapsed}} open{{/unless}}>
    <summary class="dst-roster-section-head">
      <i class="fa-solid fa-angle-right dst-roster-caret"></i>
      <span>{{label}}</span>
    </summary>

    {{#each flat}}
    <div class="dst-roster-row{{#if snoozed}} is-snoozed{{/if}}" data-ability-uuid="{{uuid}}">
      <div class="dst-roster-line">
        <button type="button" class="dst-roster-expand" data-action="toggleRosterEmbed" data-ability-uuid="{{uuid}}"{{#if noEmbed}} style="visibility: hidden" tabindex="-1"{{/if}}>
          <i class="fa-solid fa-angle-right"></i>
        </button>
        <span class="dst-roster-name">{{name}}{{#if free}} <span class="dst-roster-free">{{@root.labels.free}}</span>{{/if}}</span>
        {{#if costBadge}}
        <span class="dst-roster-cost{{#if costBadge.malice}} dst-roster-cost--malice{{/if}}">
          {{#if costBadge.malice}}<img class="dst-malice-chip" src="{{@root.maliceChipURI}}" alt="">{{else}}<i class="fa-solid fa-bolt"></i>{{/if}} {{costBadge.label}}
        </span>
        {{/if}}
        <button type="button" class="dst-roster-snooze" data-action="snoozeTrigger"
                data-dsid="{{dsid}}" data-actor-uuid="{{actorUuid}}" data-name="{{name}}"
                data-tooltip="{{#if snoozed}}{{snoozeLabel}}{{else}}{{@root.labels.snoozeTooltip}}{{/if}}">
          <i class="fa-solid {{#if snoozed}}fa-bell-slash{{else}}fa-bell{{/if}}"></i>
        </button>
      </div>
      {{#if trigger}}<div class="dst-roster-trigger">{{trigger}}</div>{{/if}}
      <div class="dst-roster-embed" data-embed-for="{{uuid}}" hidden></div>
    </div>
    {{/each}}

    {{#each groups}}
    <details class="dst-roster-group" open>
      <summary class="dst-roster-owner">
        <i class="fa-solid fa-angle-right dst-roster-caret"></i>
        <img src="{{img}}" alt="">
        <span>{{name}}</span>
        {{#if snoozedCount}}<i class="fa-solid fa-bell-slash dst-roster-muted" data-tooltip="{{@root.labels.groupMuted}}"></i>{{/if}}
      </summary>
      {{#each abilities}}
      <div class="dst-roster-row{{#if snoozed}} is-snoozed{{/if}}" data-ability-uuid="{{uuid}}">
        <div class="dst-roster-line">
          <button type="button" class="dst-roster-expand" data-action="toggleRosterEmbed" data-ability-uuid="{{uuid}}"{{#if noEmbed}} style="visibility: hidden" tabindex="-1"{{/if}}>
            <i class="fa-solid fa-angle-right"></i>
          </button>
          <span class="dst-roster-name">{{name}}{{#if free}} <span class="dst-roster-free">{{@root.labels.free}}</span>{{/if}}</span>
          {{#if costBadge}}
          <span class="dst-roster-cost{{#if costBadge.malice}} dst-roster-cost--malice{{/if}}">
            {{#if costBadge.malice}}<img class="dst-malice-chip" src="{{@root.maliceChipURI}}" alt="">{{else}}<i class="fa-solid fa-bolt"></i>{{/if}} {{costBadge.label}}
          </span>
          {{/if}}
          <button type="button" class="dst-roster-snooze" data-action="snoozeTrigger"
                  data-dsid="{{dsid}}" data-actor-uuid="{{actorUuid}}" data-name="{{name}}"
                  data-tooltip="{{#if snoozed}}{{snoozeLabel}}{{else}}{{@root.labels.snoozeTooltip}}{{/if}}">
            <i class="fa-solid {{#if snoozed}}fa-bell-slash{{else}}fa-bell{{/if}}"></i>
          </button>
        </div>
        {{#if trigger}}<div class="dst-roster-trigger">{{trigger}}</div>{{/if}}
        <div class="dst-roster-embed" data-embed-for="{{uuid}}" hidden></div>
      </div>
      {{/each}}
    </details>
    {{/each}}
  </details>
  {{/each}}
  </div>
</aside>
</div>
