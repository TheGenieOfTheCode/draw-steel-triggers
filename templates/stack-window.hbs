<div class="dst-stack">
  {{#if entries.length}}
  <ul class="dst-stack-list">
    {{#each entries}}
    <li class="dst-stack-entry dst-stack-entry--{{state}}{{#if isHeld}} dst-stack-entry--held{{/if}}">
      <div class="dst-stack-head">
        {{#if isHeld}}<i class="fa-solid fa-hourglass-half dst-stack-held-icon"></i>{{/if}}
        <strong>{{itemName}}</strong>
        {{#if ownerClickable}}
        <a class="dst-stack-owner dst-stack-owner-link" data-action="openOwner" data-uuid="{{ownerActorUuid}}">{{ownerName}}</a>
        {{else}}
        <span class="dst-stack-owner">{{ownerName}}</span>
        {{/if}}
        {{#if isHeld}}
          {{#if isGrace}}
            <span class="dst-stack-state" data-grace-until="{{graceUntil}}"></span>
          {{else}}
            <span class="dst-stack-state">{{heldStatus}}</span>
          {{/if}}
        {{else}}
          {{#unless isPending}}<span class="dst-stack-state">{{stateLabel}}</span>{{/unless}}
        {{/if}}
      </div>
      <div class="dst-stack-cause">{{causeLabel}}</div>
      {{#if embedHTML}}
      <details class="dst-stack-embed" data-entry-id="{{id}}"{{#if embedOpen}} open{{/if}}>
        <summary>{{@root.labels.showAbility}}</summary>
        <div class="dst-stack-embed-content">{{{embedHTML}}}</div>
      </details>
      {{/if}}
      {{#if showButtons}}
      <div class="dst-stack-buttons">
        <button type="button" data-action="useEntry" data-id="{{id}}"><i class="fa-solid fa-bolt"></i> {{@root.labels.use}}</button>
        <button type="button" data-action="declineEntry" data-id="{{id}}"><i class="fa-solid fa-xmark"></i> {{@root.labels.decline}}</button>
        {{#if @root.isGM}}<button type="button" data-action="dismissEntry" data-id="{{id}}" data-tooltip="{{@root.labels.dismissTooltip}}"><i class="fa-solid fa-eye-slash"></i> {{@root.labels.dismiss}}</button>{{/if}}
      </div>
      {{/if}}
      {{#if showRelease}}
      <div class="dst-stack-buttons">
        <button type="button" data-action="releaseHeld" data-resume-id="{{resumeId}}" data-tooltip="{{@root.labels.releaseTooltip}}"><i class="fa-solid fa-play"></i> {{@root.labels.release}}</button>
      </div>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="dst-stack-empty">{{labels.empty}}</p>
  {{/if}}
</div>
