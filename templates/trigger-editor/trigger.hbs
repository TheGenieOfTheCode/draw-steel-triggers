<section class="tab dst-editor-tab {{tab.cssClass}}" data-group="primary" data-tab="trigger">
  <section class="item-list-container dst-editor-list">
    <div class="item-header">
      <div class="item-column item-name">{{labels.clauses}}</div>
      <div class="item-column dst-col-event">{{labels.event}}</div>
      <div class="item-column dst-col-scope">{{labels.scope}}</div>
      <div class="item-column dst-col-range">{{labels.range}}</div>
      <div class="item-column item-controls">
        <a data-action="addClause" data-tooltip="{{labels.addClause}}"><i class="fa-solid fa-plus" inert></i></a>
      </div>
    </div>
    <ol class="item-list">
      {{#each clauses}}
      <li class="item expandable-document dst-editor-clause" data-index="{{index}}">
        <div class="item-row">
          <div class="item-column item-name" data-action="toggleRow" data-row="clause-{{index}}">
            <span class="dst-row-swatch dst-tt-c{{colour}}" inert></span>
            <div class="name">
              <div class="label">{{legend}}</div>
              <div class="keywords">{{summary}}</div>
            </div>
          </div>
          <div class="item-column dst-col-event">{{eventLabel}}</div>
          <div class="item-column dst-col-scope">{{scopeLabel}}</div>
          <div class="item-column dst-col-range">{{rangeLabel}}</div>
          <div class="item-column item-controls">
            <a class="fa-fw fa-solid fa-ellipsis-vertical" data-action="clauseMenu" data-index="{{index}}" aria-label="{{@root.labels.options}}"></a>
            <a class="fa-fw fa-solid fa-angle-{{#if expanded}}down{{else}}right{{/if}}" data-action="toggleRow" data-row="clause-{{index}}" aria-label="{{@root.labels.expand}}"></a>
          </div>
        </div>
        <div class="document-description {{#if expanded}}expanded{{/if}}">
          <div><div class="dst-row-body">
            <div class="form-group">
              <label>{{@root.labels.event}}</label>
              <div class="form-fields">
                <select data-field="event" data-index="{{index}}">
                  {{#each eventGroups}}
                  <optgroup label="{{label}}">
                    {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                  </optgroup>
                  {{/each}}
                </select>
              </div>
              <p class="hint">{{eventHint}}</p>
            </div>
            <div class="form-group">
              <label>{{@root.labels.scope}}</label>
              <div class="form-fields">
                <select data-field="scope" data-index="{{index}}">
                  {{#each scopeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </div>
              <p class="hint">{{@root.hints.scope}}</p>
            </div>
            {{#if showGroup}}
            <div class="form-group">
              <label>{{@root.labels.groupName}}</label>
              <div class="form-fields">
                <select data-field="groupSelect" data-index="{{index}}">
                  <option value="">{{@root.labels.groupNone}}</option>
                  {{#each groupOptions}}<option value="{{value}}" {{#if active}}selected{{/if}}>{{label}}</option>{{/each}}
                  {{#each customOptions}}<option value="{{value}}" {{#if active}}selected{{/if}}>{{value}}*</option>{{/each}}
                  <option value="__custom__">{{@root.labels.customEllipsis}}</option>
                </select>
                {{#if customPending}}<input type="text" class="dst-custom-input" data-index="{{index}}" placeholder="{{@root.labels.customPh}}">{{/if}}
              </div>
              <p class="hint">{{@root.hints.groupName}}</p>
            </div>
            {{/if}}
            <div class="form-group">
              <label>{{@root.labels.range}}</label>
              <div class="form-fields">
                <select data-field="rangeSelect" data-index="{{index}}">
                  {{#each rangeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
                {{#if rangeCustom}}<input type="number" min="1" step="1" data-field="rangeValue" data-index="{{index}}" value="{{rangeValue}}">{{/if}}
              </div>
              <p class="hint">{{@root.hints.range}}</p>
            </div>
            <div class="form-group stacked">
              <label>{{@root.labels.qualifiers}}</label>
              <div class="form-fields dst-qual-pills">
                {{#each qualifiers}}
                <button type="button" class="dst-qual-pill{{#if disabled}} dst-qual-off{{/if}}{{#if enforced}} dst-qual-live{{/if}}{{#if fromEffect}} dst-qual-effect{{/if}}{{#unless enforced}} dst-qual-plain{{/unless}}"
                        data-qual-toggle="{{id}}" data-index="{{../index}}" data-tooltip="{{tooltip}}">{{text}}</button>
                {{else}}
                <span class="dst-qual-empty">{{@root.labels.qualifiersNone}}</span>
                {{/each}}
              </div>
              <p class="hint">{{@root.hints.qualifiers}}</p>
            </div>
            {{#if showKeywordMode}}
            <div class="form-group">
              <label>{{@root.labels.keywordMode}}</label>
              <div class="form-fields dst-keyword-mode">
                <label class="checkbox"><input type="radio" name="dst-kw-{{index}}" value="any" data-kw-mode data-index="{{index}}" {{#unless keywordAll}}checked{{/unless}}> {{@root.labels.keywordAny}}</label>
                <label class="checkbox"><input type="radio" name="dst-kw-{{index}}" value="all" data-kw-mode data-index="{{index}}" {{#if keywordAll}}checked{{/if}}> {{@root.labels.keywordAll}}</label>
              </div>
              <p class="hint">{{keywordHint}}</p>
            </div>
            {{/if}}
            {{#if showDamageTypes}}
            <div class="form-group">
              <label>{{@root.labels.damageTypes}}</label>
              <div class="form-fields">
                <multi-select data-field="damageTypes" data-index="{{index}}">
                  {{#each damageTypeOptions}}<option value="{{value}}" {{#if active}}selected{{/if}}>{{label}}</option>{{/each}}
                </multi-select>
              </div>
              <p class="hint">{{@root.hints.damageTypes}}</p>
            </div>
            {{/if}}
            {{#if showCondition}}
            <div class="form-group">
              <label>{{@root.labels.condition}}</label>
              <div class="form-fields">
                <multi-select data-field="condition" data-index="{{index}}">
                  {{#each conditionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </multi-select>
              </div>
              <p class="hint">{{@root.hints.condition}}</p>
            </div>
            {{/if}}
            <div class="form-group">
              <label>{{@root.labels.abilityDsid}}</label>
              <div class="form-fields">
                <input type="text" data-field="abilityDsid" data-index="{{index}}" value="{{abilityDsid}}">
              </div>
              <p class="hint">{{@root.hints.abilityDsid}}</p>
            </div>
            {{#if showTiming}}
            <div class="form-group">
              <label>{{@root.labels.timing}}</label>
              <div class="form-fields">
                <select data-field="timing" data-index="{{index}}">
                  {{#each timingOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </div>
              <p class="hint">{{@root.hints.timing}}</p>
            </div>
            {{/if}}
            {{#if targeting}}
            <div class="form-group">
              <label>{{@root.labels.excludeSelfTarget}}</label>
              <div class="form-fields"><input type="checkbox" data-field="excludeSelfTarget" data-index="{{index}}" {{#if excludeSelfTarget}}checked{{/if}}></div>
              <p class="hint">{{@root.hints.excludeSelfTarget}}</p>
            </div>
            {{/if}}
            {{#if showRollHas}}
            <div class="form-group">
              <label>{{@root.labels.rollHas}}</label>
              <div class="form-fields">
                <multi-select data-field="rollHas" data-index="{{index}}">
                  {{#each rollHasOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </multi-select>
              </div>
              <p class="hint">{{@root.hints.rollHas}}</p>
            </div>
            {{/if}}
            <div class="form-group stacked">
              <label>{{@root.labels.availability}}</label>
              <div class="dst-editor-checks">
                <label class="checkbox"><input type="checkbox" data-field="ownerUnacted" data-index="{{index}}" {{#if ownerUnacted}}checked{{/if}}> {{@root.labels.ownerUnacted}}</label>
                <label class="checkbox"><input type="checkbox" data-field="anyHeroUnacted" data-index="{{index}}" {{#if anyHeroUnacted}}checked{{/if}}> {{@root.labels.anyHeroUnacted}}</label>
              </div>
              <p class="hint">{{@root.hints.checks}}</p>
            </div>
          </div></div>
        </div>
      </li>
      {{/each}}
    </ol>
  </section>
</section>
