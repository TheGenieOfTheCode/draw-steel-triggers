<section class="tab dst-editor-tab {{tab.cssClass}}" data-group="primary" data-tab="trigger">
  <section class="item-list-container dst-editor-list">
    <div class="item-header">
      <div class="item-column item-name">{{labels.clauses}}</div>
      <div class="item-column dst-col-event">{{labels.event}}</div>
      <div class="item-column dst-col-scope">{{labels.scope}}</div>
      <div class="item-column dst-col-range">{{labels.range}}</div>
      <div class="item-column item-controls">
        <a data-action="addClause" data-tooltip="{{labels.addClause}}"><i class="fa-solid fa-plus" inert></i></a>
      </div>
    </div>
    <ol class="item-list">
      {{#each clauses}}
      <li class="item expandable-document dst-editor-clause" data-index="{{index}}">
        <div class="item-row">
          <div class="item-column item-name" data-action="toggleRow" data-row="clause-{{index}}">
            <span class="dst-row-swatch dst-tt-c{{colour}}" inert></span>
            <div class="name">
              <div class="label">{{legend}}</div>
              <div class="keywords">{{summary}}</div>
            </div>
          </div>
          <div class="item-column dst-col-event">{{eventLabel}}</div>
          <div class="item-column dst-col-scope">{{scopeLabel}}</div>
          <div class="item-column dst-col-range">{{rangeLabel}}</div>
          <div class="item-column item-controls">
            <a class="fa-fw fa-solid fa-ellipsis-vertical" data-action="clauseMenu" data-index="{{index}}" aria-label="{{@root.labels.options}}"></a>
            <a class="fa-fw fa-solid fa-angle-{{#if expanded}}down{{else}}right{{/if}}" data-action="toggleRow" data-row="clause-{{index}}" aria-label="{{@root.labels.expand}}"></a>
          </div>
        </div>
        <div class="document-description {{#if expanded}}expanded{{/if}}">
          <div><div class="dst-row-body">
            <div class="form-group">
              <label>{{@root.labels.event}}</label>
              <div class="form-fields">
                <select data-field="event" data-index="{{index}}">
                  {{#each eventGroups}}
                  <optgroup label="{{label}}">
                    {{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                  </optgroup>
                  {{/each}}
                </select>
              </div>
              <p class="hint">{{eventHint}}</p>
            </div>
            <div class="form-group">
              <label>{{@root.labels.scope}}</label>
              <div class="form-fields">
                <select data-field="scope" data-index="{{index}}">
                  {{#each scopeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </div>
              <p class="hint">{{@root.hints.scope}}</p>
            </div>
            <div class="form-group">
              <label>{{@root.labels.range}}</label>
              <div class="form-fields">
                <select data-field="rangeSelect" data-index="{{index}}">
                  {{#each rangeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
                {{#if rangeCustom}}<input type="number" min="1" step="1" data-field="rangeValue" data-index="{{index}}" value="{{rangeValue}}">{{/if}}
                {{#if rangeChar}}<select data-field="rangeChar" data-index="{{index}}">{{#each charOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
                {{#if rangeAbility}}<select data-field="rangeAbility" data-index="{{index}}">{{#each abilityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
              </div>
              <p class="hint">{{@root.hints.range}}</p>
            </div>
            {{#if showRangeOn}}
            <div class="form-group">
              <label>{{@root.labels.rangeOn}}</label>
              <div class="form-fields"><input type="checkbox" data-field="rangeOn" data-index="{{index}}" {{#if rangeOnDealer}}checked{{/if}}></div>
            </div>
            {{/if}}
            {{#if showRangeMin}}
            <div class="form-group">
              <label>{{@root.labels.rangeMin}}</label>
              <div class="form-fields"><input type="number" min="1" step="1" data-field="rangeMin" data-index="{{index}}" value="{{rangeMin}}"></div>
            </div>
            {{/if}}
            {{#if showOwnerInAbility}}
            <div class="form-group">
              <label>{{@root.labels.ownerInAbility}}</label>
              <div class="form-fields"><input type="checkbox" data-field="ownerInAbilityRange" data-index="{{index}}" {{#if ownerInAbilityRange}}checked{{/if}}></div>
            </div>
            {{/if}}
            {{#if showTiming}}
            <div class="form-group">
              <label>{{@root.labels.timing}}</label>
              <div class="form-fields">
                <select data-field="timing" data-index="{{index}}">
                  {{#each timingOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </div>
              <p class="hint">{{@root.hints.timing}}</p>
            </div>
            {{/if}}
            <div class="form-group stacked">
              <label>{{@root.labels.qualifiers}}</label>
              <div class="form-fields dst-qual-pills">
                {{#each qualifiers}}
                <button type="button" class="dst-qual-pill dst-src-{{source}}" {{#if id}}data-qualifier="{{id}}"{{/if}} data-index="{{../index}}" data-tooltip="{{tooltip}}">{{text}}</button>
                {{/each}}
                <button type="button" class="dst-qual-pill dst-qual-add" data-qual-add data-index="{{index}}" data-tooltip="{{@root.labels.addQualifier}}" aria-label="{{@root.labels.addQualifier}}"><i class="fa-solid fa-plus" inert></i></button>
              </div>
              <p class="hint">{{@root.hints.qualifiers}}</p>
            </div>
          </div></div>
        </div>
      </li>
      {{/each}}
    </ol>
  </section>
</section>
