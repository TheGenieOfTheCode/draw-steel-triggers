<section class="tab dst-editor-tab standard-form {{tab.cssClass}}" data-group="primary" data-tab="config">
  {{#if gain}}
  <fieldset>
    <legend>{{gain.legend}}</legend>
    <p class="hint dst-line-sentence">{{gain.sentence}}</p>
    {{#if gain.manualWhy}}<p class="hint dst-line-note">{{gain.manualWhy}}</p>{{/if}}
    {{#if gain.bonusHint}}<p class="hint dst-line-note">{{gain.bonusHint}}</p>{{/if}}
    <div class="form-group">
      <label>{{gain.labels.name}}</label>
      <div class="form-fields"><input type="text" data-gain-field="name" value="{{gain.name}}" placeholder="{{gain.namePlaceholder}}"></div>
    </div>
    <div class="form-group">
      <label>{{gain.labels.enabled}}</label>
      <div class="form-fields"><input type="checkbox" data-gain-field="enabled" {{#if gain.enabled}}checked{{/if}}></div>
    </div>
    {{#if gain.bonusTargets}}
    <div class="form-group">
      <label>{{gain.labels.bonusTarget}}</label>
      <div class="form-fields">
        <select data-gain-field="bonusTarget">
          {{#each gain.bonusTargets}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
    </div>
    {{/if}}
    {{#unless gain.isBonus}}
    <div class="form-group">
      <label>{{gain.labels.once}}</label>
      <div class="form-fields">
        <select data-gain-field="once">
          {{#each gain.onceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
      {{#if gain.checks}}<p class="hint">{{gain.checks}}</p>{{/if}}
    </div>
    {{/unless}}
  </fieldset>
  {{/if}}

  {{#if feature}}
  <fieldset>
    <legend>{{feature.legend}}</legend>
    <p class="hint dst-line-sentence">{{feature.sentence}}</p>
    {{#if feature.covered}}<p class="hint dst-line-note">{{feature.covered}}</p>{{/if}}
    {{#if feature.tier}}<p class="hint">{{feature.tier}}</p>{{/if}}
    {{#if feature.manualWhy}}<p class="hint dst-line-note">{{feature.manualWhy}}</p>{{/if}}
    <div class="form-group">
      <label>{{feature.labels.name}}</label>
      <div class="form-fields"><input type="text" data-feature-field="name" value="{{feature.name}}" placeholder="{{feature.namePlaceholder}}"></div>
    </div>
    <div class="form-group">
      <label>{{feature.labels.enabled}}</label>
      <div class="form-fields"><input type="checkbox" data-feature-field="enabled" {{#if feature.enabled}}checked{{/if}}></div>
    </div>
    <div class="form-group">
      <label>{{feature.labels.action}}</label>
      <div class="form-fields">
        <select data-feature-field="action">
          {{#each feature.actionOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
      <p class="hint">{{feature.actionHint}}</p>
    </div>
    <div class="form-group">
      <label>{{feature.labels.neverAuto}}</label>
      <div class="form-fields"><input type="checkbox" data-feature-field="neverAutoUse" {{#if feature.neverAutoUse}}checked{{/if}}></div>
      <p class="hint">{{feature.neverAutoHint}}</p>
    </div>
    <div class="form-group">
      <label>{{feature.labels.once}}</label>
      <div class="form-fields">
        <select data-feature-field="once">
          {{#each feature.onceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </div>
    </div>
    <fieldset class="dst-prereq">
      <legend>{{feature.labels.prereq}}</legend>
      <div class="form-group">
        <label>{{feature.labels.tierLevel}}</label>
        <div class="form-fields"><input type="number" min="0" step="1" data-feature-field="tierLevel" value="{{feature.tierLevel}}" placeholder="0"></div>
      </div>
      <div class="form-group">
        <label>{{feature.labels.tierMin}}</label>
        <div class="form-fields"><input type="number" min="0" step="1" data-feature-field="tierMin" value="{{feature.tierMin}}" placeholder="0"></div>
      </div>
      <p class="hint">{{feature.prereqHint}}</p>
    </fieldset>
    <fieldset class="dst-prereq">
      <legend>{{feature.countdown.legend}}</legend>
      <div class="form-group">
        <label>{{feature.countdown.labels.start}}</label>
        <div class="form-fields"><input type="number" min="0" step="1" data-feature-field="countdownStart" value="{{feature.countdown.start}}" placeholder="0"></div>
      </div>
      <div class="form-group">
        <label>{{feature.countdown.labels.resource}}</label>
        <div class="form-fields"><select data-feature-field="countdownResource">{{#each feature.countdown.resources}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
      </div>
      <div class="form-group">
        <label>{{feature.countdown.labels.by}}</label>
        <div class="form-fields"><select data-feature-field="countdownBy">{{#each feature.countdown.byOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></div>
      </div>
      <div class="form-group">
        <label>{{feature.countdown.labels.step}}</label>
        <div class="form-fields"><input type="number" min="1" step="1" data-feature-field="countdownStep" value="{{feature.countdown.step}}"></div>
      </div>
      <p class="hint">{{feature.countdown.hint}}</p>
    </fieldset>
    {{#if feature.canIgnore}}
    <button type="button" class="dst-editor-ignore" data-action="ignoreFeature" data-tooltip="{{feature.ignoreHint}}"><i class="fa-solid fa-ban" inert></i> {{feature.labels.ignore}}</button>
    {{/if}}
  </fieldset>
  {{/if}}

  {{#unless isLine}}
  <div class="form-group">
    <label>{{labels.howOften}}</label>
    <div class="form-fields">
      <select data-field="howOften">
        {{#each howOftenOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
    <p class="hint">{{hints.howOften}}</p>
  </div>
  <div class="form-group">
    <label>{{labels.malice}}</label>
    <div class="form-fields">
      <select data-field="malice">
        {{#each maliceOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
      </select>
    </div>
    <p class="hint">{{hints.malice}}</p>
  </div>
  {{/unless}}
</section>
