  "license": "https://github.com/TheGenieOfTheCode/draw-steel-triggers/blob/main/LICENSE",
  "changelog": "https://github.com/TheGenieOfTheCode/draw-steel-triggers/releases",
  "socket": true,
  "compatibility": { "minimum": "14", "verified": "14" },
  "authors": [{ "name": "Ady", "discord": "AdyGenie" }],
