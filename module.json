{
  "id": "draw-steel-triggers",
  "title": "Draw Steel: Triggers",
  "description": "<p>Automates triggered and free triggered abilities for the Draw Steel system. Reads each ability's trigger text, detects when its condition happens in play, and either reminds the controller or holds the roll until they decide.</p>",
  "version": "0.1.0",
  "socket": true,
  "compatibility": { "minimum": "14", "verified": "14" },
  "authors": [{ "name": "Ady", "discord": "AdyGenie" }],
  "url": "https://github.com/TheGenieOfTheCode/draw-steel-triggers",
  "relationships": {
    "systems": [{ "id": "draw-steel", "type": "system", "compatibility": {} }],
    "requires": [
      { "id": "socketlib", "type": "module", "compatibility": { "minimum": "1.1.3" } }
    ],
    "optional": [
      { "id": "lib-wrapper", "type": "module", "compatibility": { "minimum": "1.12.0" } }
    ]
  },
  "esmodules": [
    "src/main.mjs"
  ],
  "styles": [
    "styles/module.css"
  ],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" }
  ]
}
